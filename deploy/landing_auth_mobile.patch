+/* ---------------- auth screens: the way back + notch safety ---------------- */
+/* The auth card is the only content on the page, so the wrap is a COLUMN: the
+   card, then the "CareQueue home / Patient view" row beneath it. Every one of
+   the 11 .login-wrap pages holds exactly one card, so stacking is safe. */
+.login-wrap{flex-direction:column;gap:16px;
+  padding:calc(20px + env(safe-area-inset-top,0px)) 20px
+           calc(20px + env(safe-area-inset-bottom,0px))}
+.auth-footer{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 20px;
+  width:100%;max-width:min(410px,calc(100vw - 32px));text-align:center}
+/* 44px minimum target: these are tapped with one thumb on a cheap Android */
+.auth-footer a{color:rgba(255,255,255,.94);font-weight:700;font-size:.9rem;
+  min-height:44px;display:inline-flex;align-items:center;
+  text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px}
+.auth-footer a:hover,.auth-footer a:focus-visible{color:#fff}
