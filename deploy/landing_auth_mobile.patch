+/* Hamburger — the phone door. Above 900px the desktop row is used instead, so
+   this stays hidden and costs nothing. It is a real <button>: keyboard and
+   screen readers get it for free, and aria-expanded tells them the state. */
+.nav-toggle{display:none;align-items:center;gap:8px;min-height:44px;min-width:44px;padding:10px 16px;
+  border:1px solid var(--line);background:#fff;border-radius:var(--r-pill);font-weight:800;font-size:.9rem;
+  color:var(--ink);cursor:pointer;box-shadow:var(--shadow-sm)}
+.nav-toggle[aria-expanded="true"]{background:var(--black);color:var(--gold);border-color:var(--black)}
+.nav-toggle .bars{display:block;width:18px;height:12px;position:relative}
+.nav-toggle .bars:before,.nav-toggle .bars:after,.nav-toggle .bars i{
+  content:"";position:absolute;left:0;right:0;height:2px;background:currentColor;border-radius:2px;
+  transition:transform .2s ease,opacity .2s ease}
+.nav-toggle .bars:before{top:0}
+.nav-toggle .bars i{top:5px}
+.nav-toggle .bars:after{bottom:0}
+.nav-toggle[aria-expanded="true"] .bars:before{transform:translateY(5px) rotate(45deg)}
+.nav-toggle[aria-expanded="true"] .bars i{opacity:0}
+.nav-toggle[aria-expanded="true"] .bars:after{transform:translateY(-5px) rotate(-45deg)}
