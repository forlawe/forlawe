 <script nonce="{{ csp_nonce }}">
+// ===== Mobile nav drawer — no library, keyboard and screen-reader safe =====
+(function(){
+  const btn = document.getElementById('nav-toggle');
+  const drawer = document.getElementById('nav-drawer');
+  if(!btn || !drawer){ return; }
+  const setOpen = (open)=>{
+    drawer.classList.toggle('open', open);
+    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
+    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
+  };
+  btn.addEventListener('click', ()=> setOpen(!drawer.classList.contains('open')));
+  // tapping any link inside the drawer closes it (anchors scroll, pages navigate)
+  drawer.addEventListener('click', (e)=>{ if(e.target.closest('a')) setOpen(false); });
+  document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') setOpen(false); });
+  // going back to desktop width must not leave a stale "open" drawer behind
+  const mq = window.matchMedia('(min-width:901px)');
+  const reset = (ev)=>{ if(ev.matches) setOpen(false); };
+  if(mq.addEventListener){ mq.addEventListener('change', reset); } else { mq.addListener(reset); }
+})();
+
