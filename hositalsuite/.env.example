# ============================================================
# Hospital Admin Manager Suite — environment configuration
# Copy to `.env` and fill in real values. NEVER commit secrets.
# ============================================================

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
# SQLite (default) or PostgreSQL, e.g.:
# DATABASE_URL=postgresql://hospuser:PASS@db-host:5432/hospitalsuite
DATABASE_URL=sqlite:///data/app.db
TIMEZONE=Africa/Lagos
# Public base URL used inside QR codes, links and report verification
PUBLIC_BASE_URL=http://localhost:8077

# --- WhatsApp Business Cloud API (Meta) ---
# Leave blank to run in "sandbox" mode (delivery simulated + logged).
WHATSAPP_MODE=sandbox                 # sandbox | cloud | disabled
WHATSAPP_PHONE_NUMBER_ID=             # Meta phone-number-id
WHATSAPP_ACCESS_TOKEN=                # permanent system-user token
WHATSAPP_VERIFY_TOKEN=                # webhook verification token
WHATSAPP_APP_SECRET=                  # optional: webhook signature check
WHATSAPP_REPORT_TEMPLATE=             # approved template name (optional)
WHATSAPP_SIMULATE_FAILURE=0           # sandbox: 1 = first send fails to demo retry

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hospital Suite <no-reply@example.org>
SMTP_TLS=1

# --- USSD (optional, Nigerian aggregator) ---
# The app exposes JSON intake APIs (/api/v1/ussd/complaint, /api/v1/ussd/booking)
# that any USSD provider (e.g. Africa's Talking, HollaTags, Termii) can POST to.
USSD_SHARED_SECRET=

# --- SMS provider interface (§38: Termii primary, Twilio fallback) ---
SMS_MODE=sandbox                       # sandbox | termii | twilio | disabled
TERMII_API_KEY=
TERMII_SENDER_ID=                      # your approved sender ID, e.g. HOSPITAL
TWILIO_ACCOUNT_SID=                    # starts with AC... from twilio.com/console
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                           # SMS From: +1415... number you own, or alphanumeric ID
TWILIO_WHATSAPP_FROM=                  # WhatsApp From: whatsapp:+14155238886 (Twilio sandbox) or whatsapp:+234...

# --- Backups ---
BACKUP_DIR=data/backups
BACKUP_KEEP=14

# ============================================================
# PRODUCTION (Render + Supabase) — the variables render.yaml sets.
# These were previously only in render.yaml, so anyone reproducing
# production on a VPS or a laptop silently ran WITHOUT them: no
# secure cookie, disk storage on an ephemeral disk, no rate-limit
# sharing. Defaults below are the same ones config.py falls back to.
# ============================================================

# --- runtime ---
PYTHON_VERSION=3.12.7             # must match runtime.txt
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- database (Supabase) ---
# Use the SESSION pooler URI + ?sslmode=require. Do NOT use the transaction
# pooler: Alembic DDL and the per-request RLS variable both need a session.
# Encode every '@' in the password as %40 and delete any [ ] characters.
# DATABASE_URL=postgresql://postgres.PROJREF:PASS%40WORD@aws-0-XX.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5                    # per web worker
DB_MAX_OVERFLOW=10
REDIS_URL=                        # optional: shared rate limiting across workers

# --- storage: Render's disk is WIPED on every deploy ---
STORAGE_BACKEND=db                # db | disk | s3 — only 'db' or 's3' survive a deploy
S3_BUCKET=                        # for STORAGE_BACKEND=s3 (Supabase Storage / R2)
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- first boot ---
AUTO_SEED=1                       # seeds ONLY an empty database; prints the first
                                  # logins once in the deploy log (no shell on Render)

# --- security ---
COOKIE_SECURE=1                   # session cookie only ever sent over HTTPS
TRUSTED_PROXY_COUNT=1             # Render/Cloudflare sit in front — without this,
                                  # rate limits and audit logs see the proxy's IP
LOGIN_MAX_FAILURES=10             # then the account locks for LOGIN_LOCKOUT_MINUTES
LOGIN_LOCKOUT_MINUTES=15
SENTRY_DSN=                       # optional: error tracking

# --- mail (pick one van; Resend is the documented default) ---
RESEND_API_KEY=
MAIL_FROM=                        # must be a sender you verified with the provider
BREVO_API_KEY=                    # optional spare
SENDGRID_API_KEY=                 # optional spare

# --- NDPA / privacy notice (shown on /privacy) ---
DPO_NAME=Hospital Admin
DPO_EMAIL=
DATA_RESIDENCY=Frankfurt, EU (Render) / AWS EU-West (Supabase) — see privacy notice
RETENTION_DAYS=2190               # 6 years; the purge job enforces a floor of 30
